{
  "name": "screenboard",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Screenshots, straight to your clipboard.",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "store:assets": "node scripts/generate-store-assets.mjs",
    "check": "tsc --noEmit && eslint . && vitest run && vite build"
  },
  "packageManager": "pnpm@11.16.0",
  "dependencies": {
    "lucide-react": "^0.468.0",
    "idb": "^8.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "puppeteer-core": "^24.0.0",
    "sharp": "^0.33.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
